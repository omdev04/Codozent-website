{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codozent-website",
  "main": "_worker.js",
  "compatibility_date": "2026-11-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "run_worker_first": [
      "/",
      "/index.html",
      "/blog-details.html",
      "/api/*",
      "/admin",
      "/admin/*"
    ]
  },
  "build": {
    "command": "node build-env.js"
  }
}
