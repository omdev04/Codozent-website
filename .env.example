# ==========================================
# Codozent Technologies - Cloudflare Edge Architecture
# Architecture: Cloudflare Worker + Edge SSR + Supabase PostgreSQL
# ==========================================

# 1. Supabase Cloud Configuration (Found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=

# 2. Administrator Authentication (Used to sign in at /admin/login)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# 3. Session Security (Any random 32+ character string for signing session JWTs)
CMS_SECRET_KEY=

# 4. Cloudinary Storage (Optional - for image upload features)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
